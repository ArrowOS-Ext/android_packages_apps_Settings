<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_container"
    android:background="@drawable/arrow_homepage_card_account"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginBottom="2dp"
    android:clipToPadding="false">

    <LinearLayout
        android:background="@drawable/arrow_homepage_card_account"
        android:clipChildren="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_padding_horizontal"
        android:clipToOutline="true">

        <androidx.cardview.widget.CardView
            android:id="@+id/arrow_homepage_header_container"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/card_radius_outer"
            app:cardElevation="0dp">

            <com.arrow.support.ui.ArrowCardPreferenceWP
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:elevation="0dp"
                android:gravity="center"
                android:orientation="vertical"
                app:blurEffect="8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/system_accent2_800"
                android:alpha="0.6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:clipToPadding="false"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/arrow_avatar"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="16dp" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/arrow_owner_account"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:singleLine="true"
                            android:text="@string/about_settings"
                            android:textColor="@color/arrow_themes_text_color_primary"
                            android:layout_below="@id/arrow_avatar"
                            android:layout_alignStart="@id/arrow_avatar"
                            style="@style/op_control_text_style_h6"/>

                        <TextView
                            android:id="@+id/arrow_account_summary"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/arrow_homepage_account_summary"
                            android:textSize="12dp"
                            android:textColor="@color/arrow_themes_text_color_secondary"
                            android:alpha="0.8"
                            android:layout_below="@id/arrow_owner_account"
                            android:layout_alignStart="@id/arrow_owner_account"
                            style="@style/op_control_text_style_body1"/>

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>
